# TradingAgents (Claude Code edition) — no LLM API keys needed.
# Everything below is OPTIONAL; the default pipeline runs fully keyless
# (yfinance, Reddit RSS, StockTwits, Polymarket).

# FRED (Federal Reserve macro data: rates, inflation, labor, growth) — used by
# the news analyst's `macro` command. Free key:
# https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Alpha Vantage — alternative vendor for prices/indicators/fundamentals/news.
# Enable per category with TRADINGAGENTS_VENDOR_* below. Free key:
# https://www.alphavantage.co/support/#api-key
#ALPHA_VANTAGE_API_KEY=

# Data-vendor chain per category ("yfinance", "alpha_vantage", or a
# comma-separated fallback chain like "yfinance,alpha_vantage").
#TRADINGAGENTS_VENDOR_CORE_STOCK_APIS=yfinance
#TRADINGAGENTS_VENDOR_TECHNICAL_INDICATORS=yfinance
#TRADINGAGENTS_VENDOR_FUNDAMENTAL_DATA=yfinance
#TRADINGAGENTS_VENDOR_NEWS_DATA=yfinance

# Pipeline knobs (also settable per run via /tradingagents --depth)
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_BENCHMARK_TICKER=

# Paths
#TRADINGAGENTS_RESULTS_DIR=~/.tradingagents/logs
#TRADINGAGENTS_CACHE_DIR=~/.tradingagents/cache
#TRADINGAGENTS_MEMORY_LOG_PATH=~/.tradingagents/memory/trading_memory.md
